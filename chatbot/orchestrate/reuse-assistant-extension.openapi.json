{
  "openapi": "3.0.3",
  "info": {
    "title": "ReUse Assistant Actions",
    "version": "1.0.0",
    "description": "Operações que o assistente do ReUse executa em nome do usuário logado. A conta é identificada pelo X-ReUse-Action-Token (payload privado do Web Chat), nunca por um ID digitado no chat."
  },
  "servers": [{ "url": "https://reuse-web-ten.vercel.app" }],
  "security": [{ "ExtensionApiKey": [] }],
  "components": {
    "securitySchemes": {
      "ExtensionApiKey": { "type": "apiKey", "in": "header", "name": "X-ReUse-Extension-Key" }
    },
    "schemas": {
      "Summary": {
        "type": "object",
        "properties": {
          "ok": { "type": "boolean" },
          "total": { "type": "integer" },
          "disponiveis": { "type": "integer" },
          "pausados": { "type": "integer" },
          "reservados": { "type": "integer" },
          "doados": { "type": "integer" },
          "titulos": { "type": "string" },
          "message": { "type": "string" }
        }
      },
      "ChangeResult": {
        "type": "object",
        "properties": {
          "ok": { "type": "boolean" },
          "alterados": { "type": "integer" },
          "message": { "type": "string" }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "ok": { "type": "boolean" },
          "message": { "type": "string" }
        }
      }
    }
  },
  "paths": {
    "/api/assistant/actions/items/summary": {
      "get": {
        "operationId": "getMyItemsSummary",
        "summary": "Consultar meus anúncios",
        "parameters": [
          {
            "name": "X-ReUse-Action-Token",
            "in": "header",
            "required": true,
            "description": "Mapear para ${system_integrations.chat.private.user_payload}.reuse_action_token",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "Resumo dos anúncios", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Summary" } } } },
          "401": { "description": "Chave da extensão inválida", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "403": { "description": "Usuário não logado ou token expirado", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/api/assistant/actions/items/pause": {
      "post": {
        "operationId": "pauseMyAvailableItems",
        "summary": "Pausar meus anúncios disponíveis",
        "parameters": [
          {
            "name": "X-ReUse-Action-Token",
            "in": "header",
            "required": true,
            "description": "Mapear para ${system_integrations.chat.private.user_payload}.reuse_action_token",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "Resultado", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ChangeResult" } } } },
          "401": { "description": "Chave da extensão inválida", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "403": { "description": "Usuário não logado ou token expirado", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/api/assistant/actions/items/reactivate": {
      "post": {
        "operationId": "reactivateMyPausedItems",
        "summary": "Reativar meus anúncios pausados",
        "parameters": [
          {
            "name": "X-ReUse-Action-Token",
            "in": "header",
            "required": true,
            "description": "Mapear para ${system_integrations.chat.private.user_payload}.reuse_action_token",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "Resultado", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ChangeResult" } } } },
          "401": { "description": "Chave da extensão inválida", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "403": { "description": "Usuário não logado ou token expirado", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    }
  }
}
